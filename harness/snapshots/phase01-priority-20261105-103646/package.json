{
  "name": "neta-uthche",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @neta/game",
    "build": "npm run build -w @neta/game && npm run build -w @neta/admin",
    "start": "npm run start -w @neta/server",
    "dev:admin": "npm run dev -w @neta/admin",
    "dev:server": "npm run dev -w @neta/server",
    "assets:audio": "node --experimental-strip-types assets/source/generate-audio.mjs && node assets/source/analyze-footsteps.mjs",
    "assets:voices": "node assets/source/generate-voices.mjs",
    "assets:missions": "node assets/source/generate-mission-animations.mjs && node assets/source/analyze-mission-footsteps.mjs",
    "preview": "npm run preview -w @neta/game",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "assets": "node assets/source/generate.mjs",
    "assets:materials": "node assets/source/build-surface-maps.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
