{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "apps/game/src",
    "apps/game/vite.config.ts",
    "apps/admin/src",
    "apps/admin/vite.config.ts",
    "apps/server/src",
    "packages/shared/src",
    "tests"
  ]
}
